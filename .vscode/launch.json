{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch ECommerce.Api (Project)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}\\ECommerce.Api\\bin\\Debug\\net10.0\\ECommerce.Api.dll",
            "args": ["--urls", "https://localhost:7151"],
            "cwd": "${workspaceFolder}\\ECommerce.Api",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "stopAtEntry": false,
            "console": "internalConsole",
            "serverReadyAction": {
                "pattern": "Now listening on:\\s+(https?://\\S+)",
                "action": "openExternally",
                "uriFormat": "%s/swagger/index.html"
            }
        },
        {
            "name": "Attach to .NET Core Process",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ]
}